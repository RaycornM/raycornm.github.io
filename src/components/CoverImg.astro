---
// CoverImg.astro - 卡片/图集封面图（absolute 填满父容器）
// 用 Astro <Image> 处理：本地 ImageMetadata 会优化为 /_astro/*.webp，
// 远程 URL 交给图像服务抓取（避免浏览器热链被 403/超时）。
// 父容器需 position: relative/absolute。
import { Image } from 'astro:assets';
import FallbackImage from '../assets/blog-placeholder-1.jpg';

interface Props {
	src?: any;
	alt?: string;
	fit?: 'cover' | 'contain';
	width?: number;
	height?: number;
	loading?: 'lazy' | 'eager';
	zoom?: boolean; // 是否启用 hover 放大所需的 transform transition
}

const {
	src,
	alt = '',
	fit = 'cover',
	width = 960,
	height = 720,
	loading = 'lazy',
	zoom = false,
} = Astro.props;

const img = src ?? FallbackImage;
---

<Image
	src={img}
	alt={alt}
	width={width}
	height={height}
	loading={loading}
	decoding="async"
	referrerpolicy="no-referrer"
	class:list={['cover-img', `fit-${fit}`, { zoom }]}
/>

<style>
	.cover-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.cover-img.fit-contain {
		object-fit: contain;
	}
	.cover-img.zoom {
		transition: transform 8s var(--ease-soft);
	}
</style>
