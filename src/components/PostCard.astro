---
import { getImageSrc } from "../utils/image";

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      pubDate: string | Date;
      description: string;
      heroImage?: string | { src: string };
    };
  };
  showImage?: boolean;
  variant?: "featured" | "default" | "scatter-featured" | "scatter";
  prefix?: string;
}

const { post, showImage = true, variant = "default", prefix = "/blog" } = Astro.props;
const isFeatured = variant === "featured" || variant === "scatter-featured";
const placeholder = "/assets/blog-placeholder-about.jpg";
---

<a href={`${prefix}/${post.id}/`} class={`post-card${isFeatured ? " featured" : ""}`}>
  <div class="card-titlebar">
    <span class="dot dot-red"></span>
    <span class="dot dot-yellow"></span>
    <span class="dot dot-green"></span>
  </div>
  {showImage && (
    <img
      src={getImageSrc(post.data.heroImage, placeholder)}
      alt={post.data.title}
      class="post-image"
      loading={isFeatured ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={isFeatured ? "high" : "auto"}
    />
  )}
  <div class="post-content">
    <h3>{post.data.title}</h3>
    <p class="post-date">
      {new Date(post.data.pubDate).toLocaleDateString()}
    </p>
    <p>{post.data.description}</p>
  </div>
</a>

<style>
  .post-card {
    background: #fff;
    border-radius: 6px;
    border: 1px solid #d0d0d0;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.05);
    padding: 0;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform 0.2s cubic-bezier(0.4, 2, 0.6, 1),
      box-shadow 0.2s,
      border-color 0.2s;
    will-change: transform, box-shadow;
    display: block;
  }

  .post-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    border-color: #bbb;
    z-index: 1;
  }

  .post-card:hover .post-content h3,
  .post-card:hover .post-date {
    color: var(--accent);
  }

  .post-card:hover .post-image {
    transform: scale(1.04);
  }

  .post-card.featured {
    margin-bottom: 2rem;
  }

  /* 窗口标题栏 */
  .card-titlebar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 10px;
    height: 28px;
    background: linear-gradient(180deg, #f5f5f5 0%, #e0e0e0 100%);
    border-bottom: 1px solid #ccc;
  }

  .post-card.featured .card-titlebar {
    padding: 0 14px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #28c840; }

  .post-card.featured .dot {
    width: 12px;
    height: 12px;
  }

  .post-card:hover .card-titlebar {
    border-bottom-color: #ddd;
  }

  /* 图片 */
  .post-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .post-card:not(.featured) .post-image {
    height: 140px;
  }

  /* 内容 */
  .post-content {
    padding: 1.25rem 1.5rem;
  }

  .post-content h3 {
    margin-top: 0;
    font-family: "SmileySans-Oblique", sans-serif;
  }

  .post-date {
    color: #888;
    font-size: 0.9rem;
  }
</style>
