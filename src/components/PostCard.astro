---
import { getImageSrc } from "../utils/image";

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      pubDate: string | Date;
      description: string;
      heroImage?: string | { src: string };
    };
  };
  showImage?: boolean;
  variant?: "featured" | "default";
  prefix?: string;
}

const { post, showImage = true, variant = "default", prefix = "/blog" } = Astro.props;
const placeholder = "/assets/blog-placeholder-about.jpg";
---

<a href={`${prefix}/${post.id}/`} class={`post-card${variant === "featured" ? " featured" : ""}`}>
  {showImage && (
    <img
      src={getImageSrc(post.data.heroImage, placeholder)}
      alt={post.data.title}
      class="post-image"
      loading={variant === "featured" ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={variant === "featured" ? "high" : "auto"}
    />
  )}
  <div class="post-content">
    <h3>{post.data.title}</h3>
    <p class="post-date">
      {new Date(post.data.pubDate).toLocaleDateString()}
    </p>
    <p>{post.data.description}</p>
  </div>
</a>

<style>
  .post-card {
    background: #fff;
    border-radius: 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    padding: 0;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform 0.2s cubic-bezier(0.4, 2, 0.6, 1),
      box-shadow 0.2s;
    will-change: transform, box-shadow;
    display: block;
  }

  .post-card:hover {
    transform: translateY(-8px) scale(1.03);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    z-index: 1;
  }

  .post-card:hover .post-content h3,
  .post-card:hover .post-date {
    color: var(--accent);
  }

  .post-card:hover .post-image {
    transform: scale(1.06) rotate(-1deg);
  }

  .post-card.featured {
    margin-bottom: 2rem;
  }

  .post-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .post-card:not(.featured) .post-image {
    height: 140px;
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-content h3 {
    margin-top: 0;
    font-family: "SmileySans-Oblique", sans-serif;
  }

  .post-date {
    color: #888;
    font-size: 0.9rem;
  }
</style>
