    </div><!-- /footer-content -->

<style>
    footer {
        position: relative;
        padding: 80px 32px 60px;
        text-align: center;
        overflow: hidden;
        border-top: 1px solid var(--line-soft);
        background: var(--paper);
        color: var(--ink);
        transition: background 0.4s var(--ease-soft), color 0.4s var(--ease-soft);
    }
    .footer-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }
    .footer-content {
        position: relative;
        z-index: 1;
    }
    .footer-jp {
        font-family: var(--font-serif-jp);
        font-weight: 200;
        font-size: 32px;
        letter-spacing: 0.04em;
        margin: 0 0 16px;
        color: var(--ink);
    }
    .footer-en {
        font-family: var(--font-deco);
        font-style: italic;
        font-size: 16px;
        color: var(--ink-soft);
        margin: 0 0 40px;
    }
    .footer-meta {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin: 0 0 24px;
    }
    .social-links {
        display: flex;
        justify-content: center;
        gap: 18px;
        margin-top: 1em;
    }
    .social-links a {
        text-decoration: none;
        color: var(--ink-faint);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
    }
    .social-links a:hover {
        color: var(--pink);
        transform: translateY(-2px);
    }
    .social-links svg,
    .social-links img {
        width: 22px;
        height: 22px;
    }
    .social-links img {
        object-fit: contain;
        filter: var(--social-icon-filter, none);
    }
    .bilibili-svg,
    .instagram-svg {
        display: block;
    }
    .bilibili-img,
    .instagram-img {
        display: none;
    }
    .bilibili-link:hover .bilibili-svg,
    .instagram-link:hover .instagram-svg {
        display: none;
    }
    .bilibili-link:hover .bilibili-img,
    .instagram-link:hover .instagram-img {
        display: block;
    }
</style>

<script is:inline>
(function() {
    const canvas = document.querySelector('.footer-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, rafId;
    let tick = 0;

    function resize() {
        const parent = canvas.parentElement;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = parent.clientWidth;
        h = parent.clientHeight;
        if (w === 0 || h === 0) return;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // ── 纸墨色调：配合新设计 token（墨色网格 + 梅粉微光） ──
    const GRID_C    = 'rgba(138,135,128,0.14)';  // --ink-faint
    const GLOW_PINK = 'rgba(255,91,155,0.05)';   // --pink
    const DUST      = 'rgba(138,135,128,0.22)';

    const GRID_SPACING = 72;
    const HORIZON_Y = 0.48;

    function drawGradient() {
        const grad = ctx.createLinearGradient(0, h, 0, h * 0.2);
        grad.addColorStop(0, 'rgba(255,91,155,0.06)');
        grad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);
    }

    function drawGrid() {
        const baseline = h * HORIZON_Y;

        ctx.strokeStyle = GRID_C;
        ctx.lineWidth = 0.8;
        ctx.beginPath();

        const vCount = Math.ceil(w / GRID_SPACING) + 2;
        const vanishX = w / 2;
        for (let i = -2; i < vCount + 2; i++) {
            const x = i * GRID_SPACING + (tick * 0.05) % GRID_SPACING;
            const topW = (x - vanishX) * 0.02;
            ctx.moveTo(vanishX + topW, 0);
            ctx.lineTo(x, baseline);
            ctx.moveTo(x, baseline);
            ctx.lineTo(x, h);
        }

        const hSteps = 28;
        for (let i = 0; i <= hSteps; i++) {
            const t = i / hSteps;
            const easeT = 1 - Math.pow(1 - t, 3);
            let y;
            if (t < 0.5) {
                y = baseline - baseline * easeT * 1.4;
            } else {
                y = baseline + (h - baseline) * (easeT - 0.5) * 2;
            }
            ctx.moveTo(0, y);
            ctx.lineTo(w, y);
        }
        ctx.stroke();
    }

    function drawGlowLines() {
        const stripes = 6;
        const spacing = 72;
        const phase = (tick * 0.2) % spacing;
        for (let i = -1; i < stripes + 1; i++) {
            const y = i * spacing - phase;
            if (y < -spacing || y > h + spacing) continue;
            const alpha = 0.03 + 0.015 * Math.sin(i * 1.7 + tick * 0.01);
            ctx.fillStyle = `rgba(255,91,155,${alpha})`;
            ctx.fillRect(0, y, w, 1);
        }
    }

    function drawDust() {
        ctx.fillStyle = DUST;
        const count = Math.floor(w * h / 7000);
        const seed = tick * 37;
        for (let i = 0; i < count; i++) {
            const x = ((seed * (i + 1) * 7919) % 10000) / 10000 * w;
            const y = ((seed * (i + 2) * 6271) % 10000) / 10000 * h;
            const s = 0.3 + ((i * 13 + tick) % 7) / 20;
            ctx.fillRect(x, y, s, s);
        }
    }

    function draw() {
        ctx.clearRect(0, 0, w, h);
        drawGradient();
        drawGrid();
        drawGlowLines();
        drawDust();
        tick++;
        rafId = requestAnimationFrame(draw);
    }

    resize();
    draw();

    window.addEventListener('resize', () => { resize(); });
    document.addEventListener('astro:page-load', () => { resize(); });

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            cancelAnimationFrame(rafId);
        } else {
            draw();
        }
    });
})();
</script>
