---
// PageChrome.astro - 全站页面装饰件
// 1. load-veil：进场遮罩（demo: ma-breath-demo L120-137 / L1068-1074）
// 2. scroll-rail：右侧 1px 滚动进度轨 + 粉色进度
// 均为纯装饰，pointer-events: none，不影响交互
---

<div class="load-veil" id="load-veil" aria-hidden="true"></div>
<div class="scroll-rail" id="scroll-rail" aria-hidden="true">
	<div class="scroll-rail-fill" id="scroll-rail-fill"></div>
</div>

<style is:global>
	/* ---- load veil ---- */
	.load-veil {
		position: fixed;
		inset: 0;
		background: var(--paper);
		z-index: 99998; /* 仅次于自定义光标 99999 */
		pointer-events: none;
		opacity: 1;
		transition: opacity 0.7s var(--ease-expo);
	}
	.load-veil.veil-off {
		opacity: 0;
	}
	/* ---- scroll rail ---- */
	.scroll-rail {
		position: fixed;
		right: 18px;
		top: 50%;
		transform: translateY(-50%);
		width: 1px;
		height: 38vh;
		background: var(--line-soft);
		z-index: 9980;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.5s var(--ease-soft);
	}
	.scroll-rail.rail-on {
		opacity: 1;
	}
	.scroll-rail-fill {
		width: 100%;
		height: 100%;
		background: var(--pink);
		transform: scaleY(0);
		transform-origin: top;
		will-change: transform;
	}
	@media (max-width: 720px) {
		.scroll-rail {
			right: 8px;
			height: 28vh;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.load-veil {
			transition: none;
		}
	}
</style>

<script is:inline>
	(function () {
		// ---- load veil：页面就绪后淡出，动画结束后移除 ----
		var veil = document.getElementById("load-veil");
		if (veil) {
			var off = function () {
				veil.classList.add("veil-off");
				veil.addEventListener("transitionend", function () {
					if (veil.parentNode) veil.parentNode.removeChild(veil);
				}, { once: true });
				// 兜底：2s 后强制移除
				setTimeout(function () {
					if (veil.parentNode) veil.parentNode.removeChild(veil);
				}, 2000);
			};
			if (document.readyState === "complete") {
				requestAnimationFrame(off);
			} else {
				window.addEventListener("load", function () {
					requestAnimationFrame(off);
				});
				// 兜底：即使 load 未触发（图片超时），1.5s 后也放行
				setTimeout(off, 1500);
			}
		}

		// ---- scroll rail：内容足够高才显示 ----
		var rail = document.getElementById("scroll-rail");
		var fill = document.getElementById("scroll-rail-fill");
		if (!rail || !fill) return;

		var ticking = false;
		function update() {
			ticking = false;
			var doc = document.documentElement;
			var max = doc.scrollHeight - window.innerHeight;
			if (max < window.innerHeight * 0.25) {
				rail.classList.remove("rail-on");
				return;
			}
			rail.classList.add("rail-on");
			var p = Math.min(1, Math.max(0, (window.scrollY || doc.scrollTop) / max));
			fill.style.transform = "scaleY(" + p + ")";
		}
		function onScroll() {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		}
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll, { passive: true });
		update();
	})();
</script>
