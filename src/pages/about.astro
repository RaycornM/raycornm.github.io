---
import BaseHead from '../components/BaseHead.astro';
import CursorShadow from '../components/CursorShadow.astro';
import Spotlight from '../components/Spotlight.astro';
import PageChrome from '../components/PageChrome.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const attrTags = [
	{ label: '音游佬', rotate: 'l' },
	{ label: '乌蒙 / 中二 / SDVX', rotate: 'r' },
	{ label: '摄影', rotate: 'l' },
	{ label: 'PC · 主机 · 街机', rotate: 'r' },
	{ label: 'FF14', rotate: 'l' },
	{ label: 'NAS', rotate: 'r' },
	{ label: '机械加工', rotate: 'l' },
	{ label: '剪视频', rotate: 'r' },
];
---

<!doctype html>
<html lang="zh-Hans">
	<head>
		<BaseHead title={`About · ${SITE_TITLE}`} description="关于日暮茶会" />
	</head>
	<body>
		<CursorShadow />
		<Spotlight />
		<PageChrome />
		<Header />
		<main class="page-reveal about-main">
			<!-- 角色立绘（可交互） -->
			<div class="about-character" id="about-character" role="button" tabindex="0" aria-label="角色立绘">
				<img src="/assets/hero-character.png" alt="Character" class="about-character-img" />
				<span class="about-character-ripple"></span>
				<div class="about-character-info">
					<p>…ようこそ。新日暮里の<ruby>世界へ<rt>マスカレード</rt></ruby></p>
				</div>
			</div>

			<div class="page-inner">
				<div class="mag-eyebrow-row">
					<span class="num-circle">D</span>
					<span class="divider"></span>
					<span class="label">About</span>
					<span>·</span>
					<span>关于 / 茶会</span>
				</div>

				<p class="stagger-eyebrow pink">No. 04 — A short biography.</p>

				<h2 class="stagger-title" data-stagger>… biography.</h2>

				<div class="about-header">
					<img
						class="about-avatar"
						src="https://gh-proxy.com/https://github.com/RaycornM/person-picture-bed/blob/main/img/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20240912234811.jpg"
						alt="头像"
						loading="lazy"
						decoding="async"
					/>
					<div>
						<div class="about-name">RaycornM</div>
						<div class="about-tagline">A cup of tea before we part.</div>
					</div>
				</div>

				<div class="about-prose">
					<p>
						这个网站是一个个人分享性质的网站，"日暮茶会"，平时这里会更新我个人的摄影作品以及软件技术相关记录等。
						本人平常比较懒，随缘更新一些摄影内容，或者是平常搞软件代码遇到问题，
						解决后记录问题解决方法、配置步骤等。平日喜欢分享自己日常的所见所摄，
						在空闲时间也喜欢剪一些视频，想用媒体记录下我的这些日常。
					</p>
					<p>
						网站的技术栈主要是 Astro + MDX + CSS 搭建而成。
						如果你对网站的搭建有兴趣，可以查看我的
						<a href="https://github.com/RaycornM/person-astro-blog" target="_blank" rel="noopener noreferrer">GitHub</a>。
					</p>
					<p>感谢你的访问！</p>
				</div>

				<!-- 属性标签 -->
				<p class="about-tags-eyebrow">… attributes.</p>
				<div class="about-tags">
					{attrTags.map((t) => (
						<span class={`tag tag-rotate-${t.rotate}`}>{t.label}</span>
					))}
				</div>

				<!-- 音乐播放器（网易云外链，包在 demo 播放器框架里） -->
				<div class="player-block">
					<div class="player-block-head">
						<span class="player-block-label">BGM · 163 Playlist</span>
						<button class="player-hint-link" id="player-hint" type="button">接入说明</button>
					</div>
					<div class="player">
						<div class="player-toggle-deco" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
						</div>
						<div class="player-info">
							<div class="player-title" id="player-title">Quiet Hours</div>
							<div class="player-artist">RIMUCHAHUI · Vol. 26</div>
						</div>
						<div class="player-frame" id="music-player"></div>
					</div>
					<div class="player-hint" id="player-hint-panel" hidden>
						<p>接入方式</p>
						<p>当前使用网易云 <code>outchain</code> 外链播放器，从 <code>musicList</code> 随机选曲。</p>
						<p>想换成自制播放器（播放/进度/切歌）：准备音频直链填入 <code>PLAYLIST_CONFIG.tracks</code>，</p>
						<p>或用 163 歌曲 ID 走自建代理 <code>/api/163?id=xxx</code> → 返回 <code>&#123; url, title, artist &#125;</code>。</p>
					</div>
				</div>

				<!-- 其他平台 -->
				<div class="about-socials">
					<a href="https://space.bilibili.com/4572890?spm_id_from=333.1007.0.0" target="_blank" rel="noopener noreferrer">Bilibili</a>
					<a href="https://www.instagram.com/denkyraymond/" target="_blank" rel="noopener noreferrer">Instagram</a>
					<a href="https://github.com/RaycornM" target="_blank" rel="noopener noreferrer">GitHub</a>
				</div>
			</div>
		</main>
		<Footer />

		<script is:inline src="/scripts/reveal.js"></script>
		<script is:inline>
			// ===== 角色立绘交互 =====
			(function () {
				var char = document.getElementById('about-character');
				if (!char) return;
				var active = false;
				var timer = null;
				function toggle() {
					active = !active;
					char.classList.toggle('active', active);
					if (active) {
						if (timer) clearTimeout(timer);
						timer = setTimeout(function () {
							char.classList.remove('active');
							active = false;
						}, 2400);
					}
				}
				char.addEventListener('click', toggle);
				char.addEventListener('keydown', function (e) {
					if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
				});
			})();

			// ===== 163 播放器（沿用原外链方案） =====
			(function () {
				var musicList = [
					{ type: 3, id: 3061173126 },
					{ type: 3, id: 3063151261 },
					{ type: 3, id: 3070746499 },
					{ type: 3, id: 3076107041 },
					{ type: 3, id: 3076877353 },
					{ type: 3, id: 3077860537 },
					{ type: 3, id: 3076528968 },
					{ type: 3, id: 3074975710 },
					{ type: 3, id: 3082140158 }
				];
				var pick = musicList[Math.floor(Math.random() * musicList.length)];
				var iframe = document.createElement('iframe');
				iframe.frameBorder = 'no';
				iframe.marginWidth = '0';
				iframe.marginHeight = '0';
				iframe.width = '330';
				iframe.height = '86';
				iframe.src = '//music.163.com/outchain/player?type=' + pick.type + '&id=' + pick.id + '&auto=1&height=66';
				var box = document.getElementById('music-player');
				if (box) box.appendChild(iframe);

				var hintLink = document.getElementById('player-hint');
				var hintPanel = document.getElementById('player-hint-panel');
				if (hintLink && hintPanel) {
					hintLink.addEventListener('click', function () {
						if (hintPanel.hasAttribute('hidden')) hintPanel.removeAttribute('hidden');
						else hintPanel.setAttribute('hidden', '');
					});
				}
			})();
		</script>
	</body>
</html>

<style>
	.about-main {
		position: relative;
	}
	.page-inner {
		max-width: 960px;
		margin: 0 auto;
		padding: 100px 48px 120px;
	}

	/* ===== 头部卡片 ===== */
	.about-header {
		display: flex;
		align-items: center;
		gap: 32px;
		padding: 32px;
		background: var(--paper);
		border: 1px solid var(--hairline);
		box-shadow: 6px 6px 0 var(--paper-shadow);
		margin: 80px 0;
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 1s var(--ease-expo) 0.2s, transform 1s var(--ease-expo) 0.2s;
	}
	.in-view .about-header { opacity: 1; transform: translateY(0); }
	.about-avatar {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		border: 1px solid var(--hairline);
		box-shadow: 4px 4px 0 var(--paper-shadow);
		flex-shrink: 0;
		object-fit: cover;
	}
	.about-name {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: 32px;
		margin-bottom: 8px;
		color: var(--ink);
	}
	.about-tagline {
		font-family: var(--font-deco);
		font-style: italic;
		font-size: 18px;
		color: var(--ink-soft);
	}

	/* ===== 正文 ===== */
	.about-prose {
		font-family: var(--font-serif);
		font-size: 16px;
		line-height: 1.9;
		color: var(--ink-soft);
	}
	.about-prose p {
		margin: 0 0 24px;
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.8s var(--ease-expo), transform 0.8s var(--ease-expo);
	}
	.in-view .about-prose p { opacity: 1; transform: translateY(0); }
	.in-view .about-prose p:nth-child(1) { transition-delay: 0.1s; }
	.in-view .about-prose p:nth-child(2) { transition-delay: 0.2s; }
	.in-view .about-prose p:nth-child(3) { transition-delay: 0.3s; }
	.about-prose a {
		color: var(--pink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ===== 属性标签 ===== */
	.about-tags-eyebrow {
		font-family: var(--font-deco);
		font-style: italic;
		font-size: 18px;
		color: var(--ink-soft);
		margin: 60px 0 24px;
	}
	.about-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 12px;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 20px;
		background: var(--paper);
		border: 1px solid var(--hairline);
		box-shadow: 4px 4px 0 var(--paper-shadow);
		font-family: var(--font-serif-jp);
		font-weight: 300;
		font-size: 15px;
		letter-spacing: 0.04em;
		color: var(--ink);
		cursor: default;
		opacity: 0;
		transform-origin: center center;
	}
	.in-view .tag { animation: tagIn 0.8s var(--ease-back) forwards; }
	.in-view .tag:nth-child(1) { animation-delay: 0.05s; }
	.in-view .tag:nth-child(2) { animation-delay: 0.10s; }
	.in-view .tag:nth-child(3) { animation-delay: 0.15s; }
	.in-view .tag:nth-child(4) { animation-delay: 0.20s; }
	.in-view .tag:nth-child(5) { animation-delay: 0.25s; }
	.in-view .tag:nth-child(6) { animation-delay: 0.30s; }
	.in-view .tag:nth-child(7) { animation-delay: 0.35s; }
	.in-view .tag:nth-child(8) { animation-delay: 0.40s; }
	@keyframes tagIn {
		0%   { opacity: 0; transform: scale(0.4) rotate(0deg); }
		60%  { opacity: 1; transform: scale(1.08) rotate(2deg); }
		100% { opacity: 1; transform: scale(1) rotate(var(--tag-rotate, 0deg)); }
	}
	.tag::before {
		content: "●";
		color: var(--pink);
		font-size: 8px;
	}
	.tag-rotate-l { --tag-rotate: -2.5deg; }
	.tag-rotate-r { --tag-rotate: 1.8deg; }
	.tag:hover {
		transform: rotate(0deg) translate(-2px, -2px) !important;
		box-shadow: 6px 6px 0 var(--paper-shadow);
		animation: none;
		opacity: 1;
	}

	/* ===== 角色立绘 ===== */
	.about-character {
		position: absolute;
		top: 140px;
		right: 48px;
		width: 160px;
		z-index: 10;
		animation: charFloat 6s var(--ease-soft) infinite;
		cursor: pointer;
	}
	.about-character-img {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.15));
		background: transparent;
	}
	.about-character-ripple {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 80%;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid var(--pink);
		transform: translate(-50%, -50%) scale(1);
		opacity: 0;
		pointer-events: none;
	}
	.about-character.active .about-character-ripple {
		animation: ripple 1.2s var(--ease-expo);
	}
	@keyframes ripple {
		0%   { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
		100% { opacity: 0;   transform: translate(-50%, -50%) scale(1.7); }
	}
	.about-character-info {
		position: absolute;
		top: 50%;
		right: 100%;
		transform: translateY(-50%) translateX(0);
		background: var(--paper);
		border: 1px solid var(--hairline);
		box-shadow: 4px 4px 0 var(--paper-shadow);
		padding: 12px 16px;
		font-family: var(--font-serif);
		font-size: 12px;
		color: var(--ink);
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
		margin-right: 16px;
	}
	.about-character-info::after {
		content: "";
		position: absolute;
		top: 50%;
		right: -6px;
		transform: translateY(-50%) rotate(45deg);
		width: 10px;
		height: 10px;
		background: var(--paper);
		border-right: 1px solid var(--hairline);
		border-top: 1px solid var(--hairline);
	}
	.about-character.active .about-character-info {
		opacity: 1;
		transform: translateY(-50%) translateX(-4px);
	}
	.about-character-info p { margin: 0; }
	.about-character-info p:first-child {
		font-weight: 500;
		margin-bottom: 2px;
	}
	.about-character-info p:last-child {
		font-family: var(--font-deco);
		font-style: italic;
		color: var(--ink-soft);
	}
	@keyframes charFloat {
		0%, 100% { transform: translateY(0); }
		50%      { transform: translateY(-8px); }
	}
	.about-character:hover { animation-duration: 3s; }

	/* ===== 播放器 ===== */
	.player-block { margin-top: 80px; }
	.player-block-head {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 16px;
	}
	.player-block-label {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.player-block-label::before { content: "● "; color: var(--pink); }
	.player-hint-link {
		appearance: none;
		background: none;
		border: none;
		padding: 0 0 1px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--pink);
		border-bottom: 1px dashed var(--pink);
	}
	.player {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 20px;
		align-items: center;
		padding: 20px 24px;
		background: var(--paper);
		border: 1px solid var(--hairline);
		box-shadow: 6px 6px 0 var(--paper-shadow);
		transition: box-shadow 0.4s var(--ease-soft);
	}
	.player:hover { box-shadow: 8px 8px 0 var(--paper-shadow); }
	.player-toggle-deco {
		width: 48px;
		height: 48px;
		border: 1px solid var(--hairline);
		background: var(--pink);
		color: var(--paper);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.player-toggle-deco svg { width: 18px; height: 18px; fill: currentColor; }
	.player-info { min-width: 0; }
	.player-title {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: 15px;
		color: var(--ink);
		margin-bottom: 2px;
	}
	.player-artist {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.player-frame { line-height: 0; }
	.player-hint {
		margin-top: 16px;
		padding: 20px 24px;
		background: var(--paper-deep);
		border-left: 2px solid var(--pink);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.8;
		color: var(--ink-soft);
	}
	.player-hint p { margin: 0 0 4px; }
	.player-hint p:first-child { font-weight: 500; color: var(--ink); margin-bottom: 8px; }
	.player-hint code {
		font-family: var(--font-mono);
		background: var(--paper);
		padding: 1px 6px;
		border: 1px solid var(--line-soft);
		font-size: 11px;
	}

	/* ===== 社交链接 ===== */
	.about-socials {
		display: flex;
		gap: 24px;
		margin-top: 60px;
		padding-top: 32px;
		border-top: 1px solid var(--line-soft);
	}
	.about-socials a {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-soft);
		transition: color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
	}
	.about-socials a:hover { color: var(--pink); transform: translateY(-2px); }
	.about-socials a::before { content: "● "; color: var(--pink); }

	@media (max-width: 768px) {
		.page-inner { padding: 80px 24px 100px; }
		.about-character { top: 100px; right: 16px; width: 90px; }
		.about-character-info { display: none; }
		.about-header { flex-direction: column; align-items: flex-start; gap: 20px; }
		.player { grid-template-columns: auto 1fr; }
		.player-frame { grid-column: 1 / -1; }
	}
</style>
