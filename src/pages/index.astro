---
import BaseHead from "../components/BaseHead.astro";
import CursorShadow from "../components/CursorShadow.astro";
import Spotlight from "../components/Spotlight.astro";
import PageChrome from "../components/PageChrome.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DraggableWidget from "../components/DraggableWidget.astro";
import CoverImg from "../components/CoverImg.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import { readingTimeMinutes } from "../utils/reading-time";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 5);

const photos = (await getCollection("photo")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPhotos = photos.slice(0, 5);

function fmtDate(d: Date): string {
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  return `${mm} · ${d.getFullYear()}`;
}
const ORD = ["st", "nd", "rd", "th", "th"];

const marqueeItems = [
  { text: "日暮茶会" },
  { text: "…ようこそ。新日暮里の世界へ" },

];
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style is:global>
      /* ====== Splash v4（浅色纸张 · 终端打字 + 就地欢迎）====== */
      .splash {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: var(--paper);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .splash::after {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(26, 26, 26, 0.025) 2px, rgba(26, 26, 26, 0.025) 4px);
        pointer-events: none;
      }
      .splash.done {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s var(--ease-soft);
      }
      .splash-frame {
        width: min(680px, 90vw);
        min-height: 200px;
        padding: 36px 44px;
        border: 1px solid var(--hairline);
        background: var(--paper);
        position: relative;
        z-index: 1;
        box-shadow: 6px 6px 0 var(--paper-shadow);
      }
      .splash-frame::before {
        content: "RIMUCHAHUI SYSTEM  ·  Vol. 26  ·  2026";
        position: absolute;
        top: -10px;
        left: 24px;
        background: var(--paper);
        padding: 0 12px;
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }
      .splash-frame::after {
        content: "●  ●  ●";
        position: absolute;
        top: 14px;
        right: 18px;
        color: var(--ink-faint);
        font-size: 10px;
        letter-spacing: 4px;
      }
      .splash-lines { position: relative; z-index: 1; }
      .splash-line {
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 2;
        min-height: 1.4em;
        color: var(--ink-soft);
        letter-spacing: 0.04em;
        white-space: pre-wrap;
      }
      .splash-line .dim { color: var(--ink-faint); }
      .splash-line .pink { color: var(--pink); }
      .splash-line .ink { color: var(--ink); font-weight: 500; }
      .splash-cursor-trail {
        display: inline-block;
        color: var(--pink);
        animation: splash-blink 0.65s step-end infinite;
      }
      @keyframes splash-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
      .splash-load-bar {
        position: absolute;
        bottom: 48px;
        left: 50%;
        transform: translateX(-50%);
        width: min(680px, 90vw);
        padding: 0 44px;
        box-sizing: border-box;
        z-index: 1;
        display: flex;
        gap: 3px;
        opacity: 0;
        transition: opacity 0.3s;
        font-family: var(--font-mono);
        font-size: 11px;
      }
      .splash-load-bar.show { opacity: 1; }
      .splash-load-block { color: var(--paper-shadow); transition: color 0.3s; }
      .splash-load-block.done { color: var(--pink); }
      .splash-welcome {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 16px;
        opacity: 0;
        transition: opacity 0.5s var(--ease-expo);
        z-index: 2;
      }
      .splash-welcome.show { opacity: 1; }
      .splash-welcome-jp {
        font-family: var(--font-serif-jp);
        font-weight: 200;
        font-size: clamp(22px, 3vw, 32px);
        letter-spacing: 0.04em;
        color: var(--ink);
        margin: 0;
      }
      .splash-welcome-en {
        font-family: var(--font-deco);
        font-style: italic;
        font-size: clamp(14px, 1.5vw, 18px);
        color: var(--pink);
        letter-spacing: 0.1em;
        margin: 0;
      }
      .splash-welcome-sub {
        position: absolute;
        top: 18px;
        left: 18px;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }

      /* main 入场 */
      .main {
        opacity: 0;
        transition: opacity 0.5s var(--ease-expo) 0.1s;
      }
      .main.boot { opacity: 1; }

      @media (prefers-reduced-motion: reduce) {
        .splash { display: none; }
        .main { opacity: 1; }
      }
      @media (max-width: 480px) {
        .splash-frame { padding: 24px 18px; }
        .splash-line { font-size: 11px; }
        .splash-load-bar { bottom: 36px; padding: 0 18px; font-size: 9px; gap: 2px; }
      }
    </style>
    <noscript>
      <style>
        .splash { display: none; }
        .main { opacity: 1; }
      </style>
    </noscript>
  </head>
  <body>
    <!-- ====== Splash v4 ====== -->
    <div class="splash" id="splash">
      <div class="splash-frame">
        <div class="splash-lines" id="splash-lines">
          <div class="splash-line" id="splash-l0"></div>
          <div class="splash-line" id="splash-l1"></div>
          <div class="splash-line" id="splash-l2"></div>
          <div class="splash-line" id="splash-l3"></div>
          <div class="splash-line" id="splash-l4"></div>
          <div class="splash-line" id="splash-l5"></div>
          <div class="splash-line" id="splash-l6"></div>
          <div class="splash-line" id="splash-l7"></div>
        </div>
        <div class="splash-welcome" id="splash-welcome">
          <span class="splash-welcome-sub">●  Vol. 26</span>
          <p class="splash-welcome-jp">…ようこそ。新日暮里の世界へ</p>
          <p class="splash-welcome-en">Welcome to the masquerade.</p>
        </div>
      </div>
      <div class="splash-load-bar" id="splash-load-bar"></div>
    </div>

    <CursorShadow />
    <Spotlight />
    <PageChrome />

    <div class="main" id="main">
      <Header />

      <main>
        <!-- ===== HERO · 极简（大量留白 + 单焦点角色立绘）===== -->
        <section class="hero" id="hero-section">
          <div class="hero-meta-tl">RIMUCHAHUI · <span class="vol">VOL. 26</span></div>
          <div class="hero-meta-tr">SCROLL</div>

          <!-- 可拖拽窗口（围绕角色，缩小不抢戏） -->
          <DraggableWidget
            id="widget-1"
            title="CORN.exe"
            index={5}
            initialX="calc(64% - 210px)"
            initialY="14%"
            initialWidth={200}
            initialHeight={200}
            magnifierScale={1}
          >
            <img
              src="/assets/meme-thumb.png"
              alt="meme"
              loading="lazy"
              decoding="async"
            />
          </DraggableWidget>
          <DraggableWidget
            id="widget-2"
            title="CORN.bat"
            index={6}
            initialX="calc(96% - 230px)"
            initialY="60%"
            initialWidth={200}
            initialHeight={60}
            magnifierScale={1}
            noResize={true}
          >
            <p class="widget-note">実行中… have a tea?</p>
          </DraggableWidget>
          <DraggableWidget
            id="widget-3"
            title="CORN.dll"
            index={7}
            initialX="calc(70% - 230px)"
            initialY="80%"
            initialWidth={200}
            initialHeight={60}
            magnifierScale={1}
            noResize={true}
          >
            <p class="widget-note">loaded · 日暮茶会</p>
          </DraggableWidget>
         /*<DraggableWidget
            id="widget-4"
            title="CORN.log"
            index={8}
            initialX="calc(50% - 150px)"
            initialY="52%"
            initialWidth={180}
            initialHeight={62}
            magnifierScale={1}
            noResize={true}
          >
            <p class="widget-note">system · signal locked</p>
          </DraggableWidget>*/

          <!-- 角色立绘（居中右 + 同心圆） -->
          <div class="character">
            <span class="character-caption">MASQUERADE</span>
            <img
              src="/assets/hero-character.png"
              alt="Hero Character"
              class="character-img"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>

          <!-- 左下角 BEIJING LIVE 元数据 -->
          <div class="hero-meta-bl">
            <span class="dot">●</span>
            <span class="city">BEIJING LIVE</span>
            <span class="time" id="hero-time">--:--</span>
            <span class="sep">/</span>
            <span>UTC+8</span>
          </div>
        </section>

        <!-- ===== Meta strip ===== -->
        <div class="meta-strip">
          <div class="meta-strip-left">
            <span class="live">LIVE — 日暮茶会</span>
            <span class="vol">VOL. 26 — 2026</span>
          </div>
          <div class="meta-strip-right">
            <span>PHOTOGRAPHY &amp; CODE</span>
            <span class="barcode" aria-hidden="true" translate="no">rimuchahui</span>
          </div>
        </div>

        <!-- ===== Marquee ===== -->
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            {marqueeItems.map((i) => (
              <span class="marquee-item"><span class="num">{i.num}</span>{i.text}<span class="sep">◆</span></span>
            ))}
          </div>
          <div class="marquee-track">
            {marqueeItems.map((i) => (
              <span class="marquee-item"><span class="num">{i.num}</span>{i.text}<span class="sep">◆</span></span>
            ))}
          </div>
        </div>

        <!-- ===== SECTION · PHOTO（暗色影集）===== -->
        <section class="mag-section section-photo" id="section-photo">
          <div class="mag-eyebrow-row">
            <span class="num-circle">C</span>
            <span class="divider"></span>
            <span class="label">Album</span>
            <span>·</span>
            <span>影集 / 摄影</span>
          </div>

          <p class="stagger-eyebrow pink-soft">No. 03 — Photographs from the quiet hours.</p>

          <h2 class="stagger-title" data-stagger>… photograph.</h2>

          <h3 class="mask-title">
            <span class="mask-line"><span>记录光</span></span>
            <span class="mask-line"><span>的形状</span></span>
          </h3>

          <div class="photo-grid">
            {latestPhotos.map((photo, i) => (
              <a class={`photo-card p${i + 1}`} href={`/photo/${photo.id}/`}>
                <CoverImg src={photo.data.heroImage} alt={photo.data.title} zoom />
                <span class="photo-card-no">No. {String(i + 1).padStart(2, "0")}</span>
                <span class="photo-card-tag">Album</span>
                <div class="photo-card-overlay">
                  <div class="photo-card-meta">
                    <div class="photo-card-title">{photo.data.title}</div>
                    <div class="photo-card-date">{fmtDate(photo.data.pubDate)}</div>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <a class="photo-cta" href="/photo">
            <span class="photo-cta-line"></span>
            <span class="photo-cta-text">Browse the <em>album</em></span>
            <span class="photo-cta-arrow">→</span>
            <span class="photo-cta-line"></span>
          </a>
        </section>

        <!-- ===== SECTION · BLOG ===== -->
        <section class="mag-section section-blog" id="section-blog">
          <div class="mag-eyebrow-row">
            <span class="num-circle">B</span>
            <span class="divider"></span>
            <span class="label">Notes</span>
            <span>·</span>
            <span>笔记 / 教程 / 制图 / 软件</span>
          </div>

          <p class="stagger-eyebrow pink">No. 02 — Dispatches from the workbench.</p>

          <h2 class="stagger-title" data-stagger>… notebook.</h2>

          <h3 class="mask-title">
            <span class="mask-line"><span>工作台</span></span>
            <span class="mask-line"><span>上的笔记</span></span>
          </h3>

          <div class="blog-list">
            {latestPosts.map((post, i) => (
              <a class="blog-item" href={`/blog/${post.id}/`}>
                <span class="blog-item-no">{String(i + 1).padStart(2, "0")}<span class="small">{ORD[i] ?? "th"}</span></span>
                <div class="blog-item-body">
                  <span class="blog-item-tag">Notes · {post.data.tags[0] ?? "笔记"}</span>
                  <h4 class="blog-item-title">{post.data.title}</h4>
                  <p class="blog-item-desc">{post.data.description}</p>
                </div>
                <div class="blog-item-meta">
                  <span class="blog-item-date">{fmtDate(post.data.pubDate)}</span>
                  <span>{readingTimeMinutes(post.body)} min</span>
                  <span class="blog-item-arrow">→</span>
                </div>
              </a>
            ))}
          </div>

          <a class="blog-cta" href="/blog">
            <span class="blog-cta-line"></span>
            <span class="blog-cta-text">Read all <em>notes</em></span>
            <span class="blog-cta-arrow">→</span>
            <span class="blog-cta-line"></span>
          </a>
        </section>
      </main>

      <Footer />
    </div>

    <!-- ====== Splash 脚本（v4）====== -->
    <script is:inline>
      (function runSplash() {
        var splash = document.getElementById("splash");
        var linesEl = document.getElementById("splash-lines");
        var loadBar = document.getElementById("splash-load-bar");
        var welcome = document.getElementById("splash-welcome");
        var main = document.getElementById("main");
        if (!splash || !main) return;

        if (sessionStorage.getItem("splash-shown-v4")) {
          splash.style.display = "none";
          main.classList.add("boot");
          return;
        }

        var lines = [
          { id: "splash-l0", plain: "RIMUCHAHUI SYSTEM   Ver 1.26", html: '<span class="dim">RIMUCHAHUI SYSTEM</span>   <span class="pink">Ver 1.26</span>' },
          { id: "splash-l1", plain: "(C) 2024 — 2026  RIMUCHAHUI Project", html: '<span class="dim">(C) 2024 — 2026  RIMUCHAHUI Project</span>' },
          { id: "splash-l2", plain: "Built with Astro + CSS · Quiet Practice", html: '<span class="dim">Built with</span> <span class="ink">Astro + CSS</span> <span class="dim">· Quiet Practice</span>' },
          { id: "splash-l3", plain: "", gap: 80 },
          { id: "splash-l4", plain: "MEMORY  TEST ........ 65536K OK", html: '<span class="dim">MEMORY  TEST ........</span> <span class="ink">65536K OK</span>' },
          { id: "splash-l5", plain: "DISK    CHECK ....... OK", html: '<span class="dim">DISK    CHECK .......</span> <span class="ink">OK</span>' },
          { id: "splash-l6", plain: "SYSTEM  INIT  ....... OK", html: '<span class="dim">SYSTEM  INIT  .......</span> <span class="ink">OK</span>' },
          { id: "splash-l7", plain: "LOADING", html: '<span class="ink">LOADING</span>' },
        ];
        var totalChars = 0;
        lines.forEach(function (l) { totalChars += l.plain.length; });
        var BLOCKS = 28;
        var frag = "";
        for (var b = 0; b < BLOCKS; b++) frag += '<span class="splash-load-block" id="splash-bk' + b + '">&#x2588;</span>';
        loadBar.innerHTML = frag;
        loadBar.classList.add("show");

        var typedCount = 0, lineIdx = 0, charIdx = 0;
        function rand(min, max) { return min + Math.random() * (max - min); }
        function advanceBlocks() {
          var target = Math.floor((typedCount / Math.max(totalChars, 1)) * BLOCKS);
          target = Math.min(target, BLOCKS - 1);
          for (var b = 0; b <= target; b++) {
            var blk = document.getElementById("splash-bk" + b);
            if (blk && !blk.classList.contains("done")) blk.classList.add("done");
          }
        }
        function finishLineThenAdvance() {
          var ln = lines[lineIdx];
          var el = document.getElementById(ln.id);
          if (el && ln.html) el.innerHTML = ln.html;
          lineIdx++; charIdx = 0; typedCount += 1;
          advanceBlocks();
          setTimeout(typeChar, lineIdx < lines.length ? rand(50, 120) : 20);
        }
        function typeChar() {
          if (lineIdx >= lines.length) { finishTyping(); return; }
          var ln = lines[lineIdx];
          var el = document.getElementById(ln.id);
          if (ln.plain.length === 0) {
            if (el) el.innerHTML = "&nbsp;";
            lineIdx++;
            setTimeout(typeChar, ln.gap || 60);
            return;
          }
          if (!el) { lineIdx++; typeChar(); return; }
          el.innerHTML = ln.plain.substring(0, charIdx + 1) + '<span class="splash-cursor-trail">_</span>';
          typedCount++; charIdx++;
          advanceBlocks();
          if (charIdx < ln.plain.length) setTimeout(typeChar, rand(8, 18));
          else finishLineThenAdvance();
        }
        function finishTyping() {
          loadBar.classList.remove("show");
          setTimeout(function () {
            linesEl.style.transition = "opacity 0.2s";
            linesEl.style.opacity = "0";
            setTimeout(function () { linesEl.style.display = "none"; }, 220);
          }, 200);
          setTimeout(function () { welcome.classList.add("show"); }, 550);
          setTimeout(function () {
            welcome.classList.remove("show");
            setTimeout(function () {
              splash.classList.add("done");
              setTimeout(function () {
                splash.style.display = "none";
                main.classList.add("boot");
                sessionStorage.setItem("splash-shown-v4", "1");
              }, 400);
            }, 120);
          }, 1500);
        }
        typeChar();
      })();
    </script>

    <!-- ====== 杂志区块 reveal + 逐字标题 + 北京时间 ====== -->
    <script is:inline>
      (function () {
        // IntersectionObserver → .in-view
        var obs = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("in-view");
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );
        document.querySelectorAll(".mag-section, .reveal").forEach(function (el) { obs.observe(el); });

        // 逐字标题（SSR 已有文本，这里拆成 char spans）
        document.querySelectorAll("[data-stagger]").forEach(function (el) {
          var text = el.textContent || "";
          el.innerHTML = "";
          for (var i = 0; i < text.length; i++) {
            var span = document.createElement("span");
            span.className = "char";
            if (text[i] === " ") span.innerHTML = "&nbsp;";
            else span.textContent = text[i];
            span.style.transitionDelay = (i * 0.04) + "s";
            el.appendChild(span);
          }
        });

        // 北京时间
        var timeEl = document.getElementById("hero-time");
        function updateTime() {
          if (!timeEl) return;
          var now = new Date();
          var bj = new Date(now.toLocaleString("en-US", { timeZone: "Asia/Shanghai" }));
          timeEl.textContent =
            String(bj.getHours()).padStart(2, "0") + ":" + String(bj.getMinutes()).padStart(2, "0");
        }
        updateTime();
        setInterval(updateTime, 1000);
      })();
    </script>
  </body>
</html>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    height: calc(100svh - 54px);
    min-height: 600px;
    overflow: hidden;
    background: var(--paper);
  }

  .hero-meta-tl,
  .hero-meta-tr,
  .hero-meta-bl {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    z-index: 5;
    opacity: 0;
    animation: heroFadeIn 1s var(--ease-expo) forwards;
  }
  .hero-meta-tl { top: 32px; left: 32px; animation-delay: 0.2s; }
  .hero-meta-tl::before { content: "● "; color: var(--pink); }
  .hero-meta-tl .vol { color: var(--ink); }
  .hero-meta-tr { top: 32px; right: 32px; animation-delay: 0.4s; }
  .hero-meta-tr::before { content: "↓ "; }
  .hero-meta-bl {
    bottom: 32px;
    left: 32px;
    animation-delay: 0.6s;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .hero-meta-bl .dot { color: var(--pink); font-size: 14px; }
  .hero-meta-bl .city { color: var(--ink); }
  .hero-meta-bl .time { color: var(--ink-soft); }
  .hero-meta-bl .sep { color: var(--ink-faint); }

  @keyframes heroFadeIn { to { opacity: 1; } }

  /* 角色立绘 */
  .character {
    position: absolute;
    top: 50%;
    right: 12%;
    transform: translateY(-50%);
    width: clamp(280px, 30vw, 420px);
    z-index: 5;
    opacity: 0;
    animation:
      charReveal 1.4s var(--ease-expo) 0.5s forwards,
      kenburns 36s var(--ease-soft) infinite 1.9s;
    will-change: transform;
  }
  .character::before,
  .character::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    pointer-events: none;
    z-index: -1;
  }
  .character::before {
    width: 110%;
    height: 75%;
    border: 1px solid var(--hairline);
    transform: translate(-50%, -50%);
    animation: rotateSlow 40s linear infinite;
  }
  .character::after {
    width: 130%;
    height: 90%;
    border: 1px dashed var(--line-soft);
    transform: translate(-50%, -50%);
    animation: rotateSlow 60s linear infinite reverse;
  }
  .character-img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.18));
    background: transparent;
  }
  .character-caption {
    position: absolute;
    top: -32px;
    right: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
